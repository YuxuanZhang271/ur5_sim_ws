<?xml version="1.0"?>
<model>
  <name>ur5_endoscope</name>
  <version>1.0.0</version>
  <sdf version="1.7">ur5_endoscope.sdf</sdf>
  <description>URI-only shim: makes model://ur5_endoscope resolve to the ur5_endoscope package root, so gz-sim can find endoscope_mid.stl referenced as model://ur5_endoscope/meshes/endoscope_mid.stl.</description>
</model>
