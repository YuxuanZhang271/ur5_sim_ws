<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="endo_flex">

  <!-- ============ Parameters ============ -->
  <xacro:arg name="show_tube" default="false"/>
  <xacro:property name="SHOW_TUBE" value="$(arg show_tube)"/>

  <xacro:property name="N"           value="8"/>
  <xacro:property name="SEG_LEN"     value="0.008"/>
  <xacro:property name="SEG_RADIUS"  value="0.0015"/>
  <xacro:property name="CYL_RADIUS"  value="0.005"/>
  <xacro:property name="CYL_LEN"     value="0.005"/>
  <xacro:property name="MAX_BEND"    value="1.57079632679"/>
  <xacro:property name="PER_BEND_MAX" value="${MAX_BEND/(N-1)}"/>

  <xacro:property name="TENDON_R"     value="0.004"/>
  <xacro:property name="TENDON_VIS_R" value="0.0008"/>

  <!-- ============ Materials (global) ============ -->
  <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
  <material name="red" ><color rgba="1.0 0.0 0.0 1.0"/></material>
  <material name="camera_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="tendon_red"   ><color rgba="1.0 0.0 0.0 1.0"/></material>
  <material name="tendon_green" ><color rgba="0.0 1.0 0.0 1.0"/></material>
  <material name="tendon_blue"  ><color rgba="0.0 0.0 1.0 1.0"/></material>
  <material name="tendon_yellow"><color rgba="1.0 1.0 0.0 1.0"/></material>

  <!-- ================================================================
       Gazebo JointPositionController helper macro (velocity-command mode)
       Locks each continuum revolute joint in dartsim to the commanded
       angle without gravity sag or passive Z-axis drift.
       ================================================================ -->
  <xacro:macro name="flex_joint_position_controller" params="joint_name topic_name">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint_name}</joint_name>
        <topic>${topic_name}</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <p_gain>20.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.0</d_gain>
        <cmd_max>10.0</cmd_max>
        <cmd_min>-10.0</cmd_min>
        <initial_position>0.0</initial_position>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- ================================================================
       Tendon markers as SEPARATE LINKS.
       ================================================================ -->
  <xacro:macro name="tendon_marker_link" params="parent_link x_off y_off z_off tag name material_name">
    <link name="tendon_${name}_${tag}">
      <visual>
        <geometry><sphere radius="${TENDON_VIS_R}"/></geometry>
        <material name="${material_name}"/>
      </visual>
      <inertial>
        <mass value="1e-9"/>
        <inertia ixx="1e-15" ixy="0" ixz="0" iyy="1e-15" iyz="0" izz="1e-15"/>
      </inertial>
    </link>
    <joint name="tendon_${name}_${tag}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="tendon_${name}_${tag}"/>
      <origin xyz="${x_off} ${y_off} ${z_off}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================
       Optional blue tube visual (toggled by show_tube arg)
       ================================================================ -->
  <xacro:macro name="segment_tube_visual">
    <xacro:if value="$(arg show_tube)">
      <visual>
        <origin xyz="0 0 ${SEG_LEN/2}"/>
        <geometry><cylinder radius="${SEG_RADIUS}" length="${SEG_LEN}"/></geometry>
        <material name="blue"/>
      </visual>
    </xacro:if>
  </xacro:macro>

  <!-- ============ Root ============ -->
  <link name="flex_base_link"/>

  <joint name="base_fixed" type="fixed">
    <parent link="flex_base_link"/>
    <child link="start_cylinder"/>
  </joint>

  <link name="start_cylinder">
    <visual>
      <geometry><cylinder radius="${CYL_RADIUS}" length="${CYL_LEN}"/></geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="base_yaw" type="revolute">
    <parent link="start_cylinder"/>
    <child link="yaw_base"/>
    <origin xyz="0 0 ${CYL_LEN/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10" lower="-3.14159" upper="3.14159"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <xacro:flex_joint_position_controller joint_name="base_yaw" topic_name="/flex/base_yaw"/>

  <link name="yaw_base">
    <inertial>
      <mass value="1e-3"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="seg1_fixed" type="fixed">
    <parent link="yaw_base"/>
    <child link="segment_1"/>
  </joint>

  <!-- Segment 1 -->
  <link name="segment_1">
    <xacro:segment_tube_visual/>
    <inertial>
      <origin xyz="0 0 ${SEG_LEN/2}"/>
      <mass value="1e-3"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <xacro:tendon_marker_link parent_link="segment_1" x_off="${ TENDON_R}" y_off="0"             z_off="${SEG_LEN/2}" tag="s1" name="0"   material_name="tendon_red"/>
  <xacro:tendon_marker_link parent_link="segment_1" x_off="0"             y_off="${ TENDON_R}" z_off="${SEG_LEN/2}" tag="s1" name="90"  material_name="tendon_green"/>
  <xacro:tendon_marker_link parent_link="segment_1" x_off="${-TENDON_R}" y_off="0"             z_off="${SEG_LEN/2}" tag="s1" name="180" material_name="tendon_blue"/>
  <xacro:tendon_marker_link parent_link="segment_1" x_off="0"             y_off="${-TENDON_R}" z_off="${SEG_LEN/2}" tag="s1" name="270" material_name="tendon_yellow"/>

  <!-- ================================================================
       Segment transition
       ================================================================ -->
  <xacro:macro name="seg_joint" params="idx parent origin_z">

    <joint name="ext_yaw_${idx}" type="revolute">
      <parent link="${parent}"/>
      <child link="ext_yaw_mid_${idx}"/>
      <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100" velocity="10" lower="-3.14159" upper="3.14159"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>
    <xacro:flex_joint_position_controller joint_name="ext_yaw_${idx}" topic_name="/flex/ext_yaw"/>

    <link name="ext_yaw_mid_${idx}">
      <inertial>
        <mass value="1e-3"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="ext_pitch_${idx}" type="revolute">
      <parent link="ext_yaw_mid_${idx}"/>
      <child link="ext_pitch_mid_${idx}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100" velocity="10" lower="${-PER_BEND_MAX}" upper="${PER_BEND_MAX}"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>
    <xacro:flex_joint_position_controller joint_name="ext_pitch_${idx}" topic_name="/flex/ext_pitch"/>

    <link name="ext_pitch_mid_${idx}">
      <inertial>
        <mass value="1e-3"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="ext_yaw_back_${idx}" type="revolute">
      <parent link="ext_pitch_mid_${idx}"/>
      <child link="ext_yaw_back_mid_${idx}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100" velocity="10" lower="-3.14159" upper="3.14159"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>
    <xacro:flex_joint_position_controller joint_name="ext_yaw_back_${idx}" topic_name="/flex/ext_yaw_back"/>

    <link name="ext_yaw_back_mid_${idx}">
      <inertial>
        <mass value="1e-3"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <!-- Fixed extension offset (SEG_LEN) baked into the joint origin
      so segments stand along z of the pole. Keep this comment free of
      "colon space" sequences since it survives xacro processing and
      launch_ros yaml-parses the robot_description parameter string. -->
    <joint name="extension_${idx}" type="fixed">
      <parent link="ext_yaw_back_mid_${idx}"/>
      <child link="segment_${idx+1}"/>
      <origin xyz="0 0 ${SEG_LEN}" rpy="0 0 0"/>
    </joint>

    <link name="segment_${idx+1}">
      <xacro:segment_tube_visual/>
      <inertial>
        <origin xyz="0 0 ${SEG_LEN/2}"/>
        <mass value="1e-3"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <xacro:tendon_marker_link parent_link="segment_${idx+1}" x_off="${ TENDON_R}" y_off="0"             z_off="${SEG_LEN/2}" tag="s${idx+1}" name="0"   material_name="tendon_red"/>
    <xacro:tendon_marker_link parent_link="segment_${idx+1}" x_off="0"             y_off="${ TENDON_R}" z_off="${SEG_LEN/2}" tag="s${idx+1}" name="90"  material_name="tendon_green"/>
    <xacro:tendon_marker_link parent_link="segment_${idx+1}" x_off="${-TENDON_R}" y_off="0"             z_off="${SEG_LEN/2}" tag="s${idx+1}" name="180" material_name="tendon_blue"/>
    <xacro:tendon_marker_link parent_link="segment_${idx+1}" x_off="0"             y_off="${-TENDON_R}" z_off="${SEG_LEN/2}" tag="s${idx+1}" name="270" material_name="tendon_yellow"/>

  </xacro:macro>

  <xacro:seg_joint idx="1" parent="segment_1" origin_z="${SEG_LEN}"/>
  <xacro:seg_joint idx="2" parent="segment_2" origin_z="0"/>
  <xacro:seg_joint idx="3" parent="segment_3" origin_z="0"/>
  <xacro:seg_joint idx="4" parent="segment_4" origin_z="0"/>
  <xacro:seg_joint idx="5" parent="segment_5" origin_z="0"/>
  <xacro:seg_joint idx="6" parent="segment_6" origin_z="0"/>
  <xacro:seg_joint idx="7" parent="segment_7" origin_z="0"/>

  <joint name="end_fixed" type="fixed">
    <parent link="segment_8"/>
    <child link="end_cylinder"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="end_cylinder">
    <visual>
      <geometry><cylinder radius="${CYL_RADIUS}" length="${CYL_LEN}"/></geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <xacro:tendon_marker_link parent_link="end_cylinder" x_off="${ TENDON_R}" y_off="0"             z_off="0" tag="end" name="0"   material_name="tendon_red"/>
  <xacro:tendon_marker_link parent_link="end_cylinder" x_off="0"             y_off="${ TENDON_R}" z_off="0" tag="end" name="90"  material_name="tendon_green"/>
  <xacro:tendon_marker_link parent_link="end_cylinder" x_off="${-TENDON_R}" y_off="0"             z_off="0" tag="end" name="180" material_name="tendon_blue"/>
  <xacro:tendon_marker_link parent_link="end_cylinder" x_off="0"             y_off="${-TENDON_R}" z_off="0" tag="end" name="270" material_name="tendon_yellow"/>

  <!-- ================================================================
       Distal Endoscope Camera at the Tip of end_cylinder
       ================================================================
       end_cylinder's distal tip face is at z = +CYL_LEN/2 (+0.0025 m)
       and looks along +Z of end_cylinder.
       Gazebo camera sensors look along +X of their link frame, so
       camera_link is pitched by -90 deg (-pi/2) about Y so that
       camera_link +X aligns with end_cylinder +Z.
       ================================================================ -->
  <joint name="end_cylinder_to_camera_joint" type="fixed">
    <parent link="end_cylinder"/>
    <child link="camera_link"/>
    <origin xyz="0 0 ${CYL_LEN/2 + 0.0005}" rpy="0 -1.57079632679 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.0015" length="0.001"/></geometry>
      <material name="camera_black"/>
    </visual>
    <inertial>
      <mass value="1e-6"/>
      <inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12"/>
    </inertial>
  </link>

  <!-- Standard ROS camera optical frame (+Z forward, +X right, +Y down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="camera_optical_frame"/>

  <!-- Gazebo Harmonic sensor plugin (loads ogre2 rendering for camera) -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="endoscope_camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>60.0</update_rate>
      <topic>/endoscope_camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera name="endoscope_cam">
        <camera_info_topic>/endoscope_camera/camera_info</camera_info_topic>
        <horizontal_fov>2.2689</horizontal_fov>
        <image>
          <width>1500</width>
          <height>1500</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.008</near>
          <far>0.5</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>