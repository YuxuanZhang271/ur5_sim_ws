        segment_4:
          Value: false
        segment_5:
          Value: false
        segment_6:
          Value: false
        segment_7:
          Value: false
        segment_8:
          Value: false
        shoulder_link:
          Value: false
        start_cylinder:
          Value: false
        supporter_link:
          Value: false
        tendon_0_end:
          Value: false
        tendon_0_s1:
          Value: false
        tendon_0_s2:
          Value: false
        tendon_0_s3:
          Value: false
        tendon_0_s4:
          Value: false
