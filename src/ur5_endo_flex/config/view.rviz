Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /EndoscopeMarkers1
        - /EndoscopeCamera1
      Splitter Ratio: 0.5
    Tree Height: 705
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base:
          Value: false
        base_inertia:
          Value: false
        base_link:
          Value: true
        base_link_inertia:
          Value: false
        end_cylinder:
          Value: true
        endoscope_camera_link:
          Value: false
        endoscope_camera_optical_frame:
          Value: false
        endoscope_link:
          Value: false
        flange:
          Value: false
        flex_base_link:
          Value: false
        forearm_link:
          Value: false
        robot_supporter:
          Value: false
        seg_1:
          Value: false
        seg_1_after_pitch:
          Value: false
        seg_1_after_yaw:
          Value: false
        seg_1_tip:
          Value: false
        seg_2:
          Value: false
        seg_2_after_pitch:
          Value: false
        seg_2_after_yaw:
          Value: false
        seg_2_tip:
          Value: false
        seg_3:
          Value: false
        seg_3_after_pitch:
          Value: false
        seg_3_after_yaw:
          Value: false
        seg_3_tip:
          Value: false
        seg_4:
          Value: false
        seg_4_after_pitch:
          Value: false
        seg_4_after_yaw:
          Value: false
        seg_4_tip:
          Value: false
        seg_5:
          Value: false
        seg_5_after_pitch:
          Value: false
        seg_5_after_yaw:
          Value: false
        seg_5_tip:
          Value: false
        seg_6:
          Value: false
        seg_6_after_pitch:
          Value: false
        seg_6_after_yaw:
          Value: false
        seg_6_tip:
          Value: false
        seg_7:
          Value: false
        seg_7_after_pitch:
          Value: false
        seg_7_after_yaw:
          Value: false
        seg_7_tip:
          Value: false
        shoulder_link:
          Value: false
        start_cylinder:
          Value: true
        tool0:
          Value: false
        upper_arm_link:
          Value: false
        world:
          Value: true
        wrist_1_link:
          Value: false
        wrist_2_link:
          Value: false
        wrist_3_link:
          Value: false
      Marker Scale: 0.25
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: EndoscopeMarkers
      Namespaces:
        endoscope_current_axis: true
        endoscope_line: true
        gastrectomy_anatomy: true
        gastrectomy_labels: true
        gastrectomy_targets: true
        rcm_cone: true
        rcm_point: true
        status: true
        tracking_sightline: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /endoscope_markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: EndoscopeCamera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /endoscope_camera/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.66
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.40
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.80
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  EndoscopeCamera:
    collapsed: false
  Height: 960
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1400
  X: 60
  Y: 60